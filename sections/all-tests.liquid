<style>
.vendors-container {
  display: flex;
  flex-direction: column;
  gap: 20px;
  margin-top: 30px;
}

.vendor-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 15px;
  border: 1px solid #ddd;
  border-radius: 10px;
  background: #fff;
}

.vendor-link {
  display: flex;
  text-decoration: none;
}

.vendor-image {
  width: 80px;
  height: 80px;
  object-fit: cover;
  border-radius: 10px;
  margin-right: 20px;
}

.product-vendor {
    margin: 0;
}

.vendor-info {
  flex: 1;
}

.vendor-title {
  font-size: 18px;
  font-weight: bold;
  margin: 8px 0;
}

.vendor-tests {
  font-size: 14px;
  color: #555;
  margin-bottom: 8px;
}

.vendor-price {
  font-size: 16px;
  font-weight: bold;
  color: #0d3c74;
}

.add-to-cart-btn {
      display: inline-flex;
    justify-content: center;
    align-items: center;
    border: var(--buttons-border-width) solid rgba(var(--color-button), var(--buttons-border-opacity));
    padding: 1.2rem 2rem;
    cursor: pointer;
    font: inherit;
    text-decoration: none;
    color: rgb(var(--color-button-text));
    background-color: rgba(var(--color-button), var(--alpha-button-background));
    transition: all .3s ease;
    -webkit-appearance: none;
    appearance: none;
}
</style>

<section>
  <h2>{{ section.settings.heading }}</h2>
  <div id="vendorsContainer" class="vendors-container"></div>
</section>

<script>
function getSelectedTestsFromURL() {
  const urlParams = new URLSearchParams(window.location.search);
  const tests = urlParams.get('tests');
  return tests ? tests.split(',') : [];
}

document.addEventListener("DOMContentLoaded", function() {
  const selectedTests = getSelectedTestsFromURL();

  const allProducts = [
    {% for product in collections.all.products %}
    {
      title: "{{ product.title | escape }}",
      handle: "{{ product.handle | escape }}",
      vendor: "{{ product.vendor | escape }}",
      variantId: " {{ product.selected_or_first_available_variant.id }}",
      productUrl: " {{ product.url }}",
      price: "{{ product.price | escape }}",
      compare_at_price: "{{ product.compare_at_price | escape }}",
      image: "{{ product.featured_image | img_url: 'medium' | escape }}",
      testMeta: {{ product.metafields.custom.test | default: '[]' }}
    }{% unless forloop.last %},{% endunless %}
    {% endfor %}
  ];

  const vendorsContainer = document.getElementById("vendorsContainer");

const normalize = str => str.toLowerCase().replace(/\s+/g, '-');

const matchingVendors = allProducts.filter(product => 
  Array.isArray(product.testMeta) &&
  selectedTests.some(test => {
    const testWords = test.toLowerCase().split(/[\s-]+/); // Split test into words
    
    return product.testMeta.some(metaTest => {
      const metaWords = normalize(metaTest).split('-'); // Split metaTest into words
      
      return testWords.some(tWord => metaWords.includes(tWord));
    });
  })
);


  if (matchingVendors.length === 0) {
    vendorsContainer.innerHTML = "<p>No vendors found for selected tests.</p>";
    } else {
    matchingVendors.forEach(product => {
        const vendorCard = document.createElement("div");
        vendorCard.className = "vendor-card";

        vendorCard.innerHTML = `
            <a href='/products/${product.handle}' class="vendor-link">
                <img src="${product.image}" alt="${product.title}" class="vendor-image">
                <div class="vendor-info">
                    <h3 class="product-vendor">${product.vendor || 'Unknown Vendor'}</h3>
                    <h6 class="vendor-title">${product.title}</h6>
                    <p class="vendor-tests">Tests Provided: ${product.testMeta.join(', ')}</p>
                    <p class="vendor-price">₹${product.price / 100}</p>
                </div>
            </a>

            <button class="add-to-cart-btn" onclick="addToCart('${product.variantId.trim()}')">
                Add to Cart
            </button>
        `;

        vendorsContainer.appendChild(vendorCard);
    });


  }

});
</script>

<script>
  function addToCart(variantId) {
    variantIdd = Number(variantId)
    fetch('/cart/add.js', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
      body: JSON.stringify({ id: variantIdd, quantity: 1 })
    })
    .then(response => response.json())
    .then(data => {
      drawerUpateCustom();
    })
   <section>
  <h2>{{ section.settings.heading }}</h2>
  <div id="testsContainer" class="vendors-container"></div>
  <div id="packagesContainer" class="vendors-container"></div>
</section>

<script>
function getSelectedTestsFromURL() {
  const urlParams = new URLSearchParams(window.location.search);
  const tests = urlParams.get('tests');
  return tests ? tests.split(',') : [];
}

document.addEventListener("DOMContentLoaded", function() {
  const selectedTests = getSelectedTestsFromURL();

  const allProducts = [
    {% for product in collections.all.products %}
    {
      title: "{{ product.title | escape }}",
      handle: "{{ product.handle | escape }}",
      vendor: "{{ product.vendor | escape }}",
      variantId: "{{ product.selected_or_first_available_variant.id }}",
      productUrl: "{{ product.url }}",
      price: "{{ product.price | escape }}",
      compare_at_price: "{{ product.compare_at_price | escape }}",
      image: "{{ product.featured_image | img_url: 'medium' | escape }}",
      tags: {{ product.tags | json }}
    }{% unless forloop.last %},{% endunless %}
    {% endfor %}
  ];

  const testsContainer = document.getElementById("testsContainer");
  const packagesContainer = document.getElementById("packagesContainer");

  const normalizeTag = tag => tag.replace(/^test_|^package_/, '').toLowerCase();

  const matchingProducts = allProducts.filter(product =>
    product.tags.some(tag => {
      const cleanTag = normalizeTag(tag);
      return selectedTests.some(test => test.toLowerCase() === cleanTag);
    })
  );

  const testsProducts = matchingProducts.filter(p =>
    p.tags.some(tag => tag.startsWith('test_'))
  );

  const packagesProducts = matchingProducts.filter(p =>
    p.tags.some(tag => tag.startsWith('package_'))
  );

  function renderProducts(container, products, type) {
    if (products.length === 0) {
      container.innerHTML = `<p>No ${type} found for selected tests.</p>`;
      return;
    }

    products.forEach(product => {
      const vendorCard = document.createElement("div");
      vendorCard.className = "vendor-card";

      const productTags = product.tags
        .map(tag => normalizeTag(tag))
        .join(', ');

      vendorCard.innerHTML = `
        <a href='/products/${product.handle}' class="vendor-link">
            <img src="${product.image}" alt="${product.title}" class="vendor-image">
            <div class="vendor-info">
                <h3 class="product-vendor">${product.vendor || 'Unknown Vendor'}</h3>
                <h6 class="vendor-title">${product.title}</h6>
                <p class="vendor-tests">Tests Provided: ${productTags}</p>
                <p class="vendor-price">₹${product.price / 100}</p>
            </div>
        </a>

        <button class="add-to-cart-btn" onclick="addToCart('${product.variantId.trim()}')">
            Add to Cart
        </button>
      `;

      container.appendChild(vendorCard);
    });
  }

  // Render separately
  renderProducts(testsContainer, testsProducts, 'tests');
  renderProducts(packagesContainer, packagesProducts, 'packages');
});
</script>




