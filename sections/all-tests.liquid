<style>
.vendors-container {
  display: flex;
  flex-direction: column;
  gap: 20px;
  margin-top: 30px;
}

.vendor-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 5px 15px;
  border: 1px solid #ddd;
  border-radius: 10px;
  background: #fff;
}

.vendor-link {
  display: flex;
  text-decoration: none;
}

.vendor-image {
  width: 80px;
  height: 80px;
  object-fit: cover;
  border-radius: 10px;
  margin-right: 20px;
}

.product-vendor { margin: 0; }

.vendor-info { flex: 1; }

.vendor-title { font-size: 18px; font-weight: bold; margin: 8px 0; }

.vendor-tests { font-size: 14px; color: #555; margin-bottom: 8px; }

.vendor-price { font-size: 16px; font-weight: bold; color: #0d3c74; }

.add-to-cart-btn {
  display: inline-flex;
  justify-content: center;
  align-items: center;
  border: var(--buttons-border-width) solid rgba(var(--color-button), var(--buttons-border-opacity));
  padding: 1.2rem 2rem;
  cursor: pointer;
  font: inherit;
  text-decoration: none;
  color: rgb(var(--color-button-text));
  background-color: rgba(var(--color-button), var(--alpha-button-background));
  transition: all .3s ease;
  -webkit-appearance: none;
  appearance: none;
}
.alltests {
    padding-left: 3.2rem;
    padding-right: 3.2rem;
}
</style>

{% assign all_collections = collections | map: 'title' %}
{% assign all_collections_handles = collections | map: 'handle' %}

<section class="alltests">
  <h2>{{ section.settings.heading }}</h2>
  <div class="vendors-container">
    <h2>Tests</h2>
    <div id="testsContainer"></div>
  </div>
  <div class="vendors-container">
    <h2>Packages</h2>
    <div id="packagesContainer"></div>
  </div>
</section>

<script>
function getSelectedTestsFromURL() {
  const urlParams = new URLSearchParams(window.location.search);
  const tests = urlParams.get('tests');
  return tests ? tests.split(',').map(t => t.trim().toLowerCase()) : [];
}

document.addEventListener("DOMContentLoaded", function() {
  const selectedTests = getSelectedTestsFromURL();
  const userPincode = sessionStorage.getItem('userPincode');

  const allCollections = [
    {% for collection in collections %}
    { title: "{{ collection.title | escape }}", handle: "{{ collection.handle | escape }}" }{% unless forloop.last %},{% endunless %}
    {% endfor %}
  ];

  const allProducts = [
    {% for product in collections.all.products %}
    {
      title: "{{ product.title | escape }}",
      handle: "{{ product.handle | escape }}",
      vendor: "{{ product.vendor | escape }}",
      variantId: "{{ product.selected_or_first_available_variant.id }}",
      productUrl: "{{ product.url }}",
      price: "{{ product.price | escape }}",
      image: "{{ product.featured_image | img_url: 'medium' | escape }}",
      tags: {{ product.tags | json | default: '[]' }},
      availableLocations: {{ product.metafields.custom.available_location | default: '[]' }}
    }{% unless forloop.last %},{% endunless %}
    {% endfor %}
  ];

  const testsContainer = document.getElementById("testsContainer");
  const packagesContainer = document.getElementById("packagesContainer");

  const normalizeTag = tag => tag.replace(/^test_|^package_/, '').toLowerCase();

  const uniqueProductsMap = new Map();

  allProducts.forEach(product => {
    const matchesTest = product.tags.some(tag => selectedTests.includes(normalizeTag(tag)));
    const matchesPincode = !userPincode || 
      (Array.isArray(product.availableLocations) && product.availableLocations.includes(Number(userPincode)));

    if (matchesTest && matchesPincode && !uniqueProductsMap.has(product.handle)) {
      uniqueProductsMap.set(product.handle, product);
    }
  });

  const uniqueProducts = Array.from(uniqueProductsMap.values());

  const testsProducts = uniqueProducts.filter(p => p.tags.some(tag => tag.startsWith('test_')));
  const packagesProducts = uniqueProducts.filter(p => p.tags.some(tag => tag.startsWith('package_')));

  function findCollectionForVendor(vendor) {
    const lowerVendor = vendor.toLowerCase();
    for (const col of allCollections) {
      if (col.title.toLowerCase().includes(lowerVendor)) {
        return `/collections/${col.handle}`;
      }
    }
    // fallback
    return '/collections/all';
  }

  function renderProducts(container, products, type) {
    container.innerHTML = '';
    if (products.length === 0) {
      container.innerHTML = `<p>No ${type} found for selected tests/pincode.</p>`;
      return;
    }

    products.forEach(product => {
      const vendorCollectionLink = findCollectionForVendor(product.vendor || '');
      const productTags = product.tags.map(tag => normalizeTag(tag)).join(', ');

      const vendorCard = document.createElement("div");
      vendorCard.className = "vendor-card";

      vendorCard.innerHTML = `
        <a href='${vendorCollectionLink}' class="vendor-link">
          <img src="${product.image}" alt="${product.title}" class="vendor-image">
          <div class="vendor-info">
            <h3 class="product-vendor">${product.vendor || 'Unknown Vendor'}</h3>
            <h6 class="vendor-title">${product.title}</h6>
            <p class="vendor-tests">Tests Provided: ${productTags}</p>
            <p class="vendor-price">₹${product.price / 100}</p>
          </div>
        </a>

        <button class="add-to-cart-btn" onclick="addToCart('${product.variantId.trim()}')">
          Add to Cart
        </button>
      `;

      container.appendChild(vendorCard);
    });
  }

  renderProducts(testsContainer, testsProducts, 'tests');
  renderProducts(packagesContainer, packagesProducts, 'packages');
});

// Add to cart function remains the same
function addToCart(variantId) {
  const variantIdNum = Number(variantId);
  fetch('/cart/add.js', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
    body: JSON.stringify({ id: variantIdNum, quantity: 1 })
  })
  .then(res => res.json())
  .then(data => {
    drawerUpateCustom();
  })
  .catch(err => {
    console.error('Add to cart failed:', err);
    alert('Failed to add product to cart.');
  });
}

function drawerUpateCustom() {
  console.log('here');
  fetch(`${routes.cart_url}?section_id=cart-drawer`)
    .then(res => res.text())
    .then(result => {
      const html = new DOMParser().parseFromString(result, 'text/html');
      const cartDrawer = document.querySelector('cart-drawer');
      cartDrawer.innerHTML = '';
      cartDrawer.append(html.documentElement.querySelector('#CartDrawer'));
      cartDrawer.classList.remove('is-empty');

      const cartIcon = document.querySelector('.header__icon--cart');
      if (!cartIcon) return;

      let cartBubble = cartIcon.querySelector('.cart-count-bubble');
      if (!cartBubble) {
        cartBubble = document.createElement('div');
        cartBubble.className = 'cart-count-bubble';
        cartBubble.innerHTML = '<span aria-hidden="true">1</span><span class="visually-hidden">1 item</span>';
        cartIcon.appendChild(cartBubble);
      } else {
        const visibleSpan = cartBubble.querySelector('span[aria-hidden="true"]');
        let currentQty = parseInt(visibleSpan.innerText) || 0;
        visibleSpan.innerText = currentQty + 1;

        const hiddenSpan = cartBubble.querySelector('.visually-hidden');
        hiddenSpan.innerText = `${currentQty + 1} item${currentQty + 1 > 1 ? 's' : ''}`;
      }

      const cartIconButton = document.querySelector('#cart-icon-bubble');
      if (cartIconButton) cartIconButton.click();
    })
    .catch(err => console.error('Cart update failed:', err));
}
</script>

