<style>
.vendors-container {
  display: flex;
  flex-direction: column;
  gap: 20px;
  margin-top: 30px;
}

.vendor-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 15px;
  border: 1px solid #ddd;
  border-radius: 10px;
  background: #fff;
}

.vendor-image {
  width: 80px;
  height: 80px;
  object-fit: cover;
  border-radius: 10px;
  margin-right: 20px;
}

.vendor-info {
  flex: 1;
}

.vendor-title {
  font-size: 18px;
  font-weight: bold;
  margin-bottom: 8px;
}

.vendor-tests {
  font-size: 14px;
  color: #555;
  margin-bottom: 8px;
}

.vendor-price {
  font-size: 16px;
  font-weight: bold;
  color: #0d3c74;
}

.add-to-cart-btn {
  background: #0d3c74;
  color: white;
  padding: 10px 15px;
  border-radius: 8px;
  text-decoration: none;
  font-weight: bold;
}
</style>

<section>
  <h2>{{ section.settings.heading }}</h2>
  <div id="vendorsContainer" class="vendors-container"></div>
</section>

<script>
function getSelectedTestsFromURL() {
  const urlParams = new URLSearchParams(window.location.search);
  const tests = urlParams.get('tests');
  return tests ? tests.split(',') : [];
}

document.addEventListener("DOMContentLoaded", function() {
  const selectedTests = getSelectedTestsFromURL();

  const allProducts = [
    {% for product in collections.all.products %}
      {
        title: {{ product.title | json }},
        handle: {{ product.handle | json }},
        price: {{ product.price | json }},
        compare_at_price: {{ product.compare_at_price | json }},
        image: {{ product.featured_image | img_url: 'medium' | json }},
        testMeta: {{ product.metafields.custom.test | json }}
      }{% unless forloop.last %},{% endunless %}
    {% endfor %}
  ];

  console.log('87', allProducts)

  const vendorsContainer = document.getElementById("vendorsContainer");

  const matchingVendors = allProducts.filter(product =>
    selectedTests.some(test => String(product.testMeta || '').toLowerCase() === test.toLowerCase())
    );


  if (matchingVendors.length === 0) {
    vendorsContainer.innerHTML = "<p>No vendors found for selected tests.</p>";
  } else {
    matchingVendors.forEach(product => {
      const vendorCard = document.createElement("div");
      vendorCard.className = "vendor-card";
      vendorCard.innerHTML = `
        <img src="${product.image}" alt="${product.title}" class="vendor-image">
        <div class="vendor-info">
          <h3 class="vendor-title">${product.title}</h3>
          <p class="vendor-tests">Tests Provided: ${product.testMeta}</p>
          <p class="vendor-price">₹${product.price}</p>
        </div>
        <a href="/products/${product.handle}" class="add-to-cart-btn">View Details</a>
      `;
      vendorsContainer.appendChild(vendorCard);
    });
  }
});
</script>

{% schema %}
{
  "name": "All Test Vendors",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Available Labs"
    }
  ],
  "presets": [
    {
      "name": "Default",
      "category": "Tests",
      "settings": {
        "heading": "Available Labs"
      }
    }
  ]
}
{% endschema %}
