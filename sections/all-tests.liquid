<style>
.vendors-container {
  display: flex;
  flex-direction: column;
  gap: 20px;
  margin-top: 30px;
}

.vendor-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 15px;
  border: 1px solid #ddd;
  border-radius: 10px;
  background: #fff;
}

.vendor-image {
  width: 80px;
  height: 80px;
  object-fit: cover;
  border-radius: 10px;
  margin-right: 20px;
}

.product-vendor {
    margin: 0;
}

.vendor-info {
  flex: 1;
}

.vendor-title {
  font-size: 18px;
  font-weight: bold;
  margin: 8px 0;
}

.vendor-tests {
  font-size: 14px;
  color: #555;
  margin-bottom: 8px;
}

.vendor-price {
  font-size: 16px;
  font-weight: bold;
  color: #0d3c74;
}

.add-to-cart-btn {
  background: #0d3c74;
  color: white;
  padding: 10px 15px;
  border-radius: 8px;
  text-decoration: none;
  font-weight: bold;
}
</style>

<section>
  <h2>{{ section.settings.heading }}</h2>
  <div id="vendorsContainer" class="vendors-container"></div>
</section>

<script>
function getSelectedTestsFromURL() {
  const urlParams = new URLSearchParams(window.location.search);
  const tests = urlParams.get('tests');
  return tests ? tests.split(',') : [];
}

document.addEventListener("DOMContentLoaded", function() {
  const selectedTests = getSelectedTestsFromURL();

  const allProducts = [
    {% for product in collections.all.products %}
    {
      title: "{{ product.title | escape }}",
      handle: "{{ product.handle | escape }}",
      vendor: "{{ product.vendor | escape }}",
      price: "{{ product.price | escape }}",
      compare_at_price: "{{ product.compare_at_price | escape }}",
      image: "{{ product.featured_image | img_url: 'medium' | escape }}",
      testMeta: {{ product.metafields.custom.test | default: '[]' }}
    }{% unless forloop.last %},{% endunless %}
    {% endfor %}
  ];

  const vendorsContainer = document.getElementById("vendorsContainer");

const normalize = str => str.toLowerCase().replace(/\s+/g, '-');

const matchingVendors = allProducts.filter(product => 
  Array.isArray(product.testMeta) &&
  selectedTests.some(test =>
    product.testMeta.some(metaTest => normalize(metaTest).includes(test.toLowerCase()) || test.toLowerCase().includes(normalize(metaTest)))
  )
);



console.log('97', matchingVendors)


  if (matchingVendors.length === 0) {
    vendorsContainer.innerHTML = "<p>No vendors found for selected tests.</p>";
    } else {
    matchingVendors.forEach(product => {
        const vendorCard = document.createElement("div");
        vendorCard.className = "vendor-card";
        vendorCard.innerHTML = `
        <img src="${product.image}" alt="${product.title}" class="vendor-image">
        <div class="vendor-info">
            <h3 class="product-vendor">${product.vendor || 'Unknown Vendor'}</h3>
            <h6 class="vendor-title">${product.title}</h6>
            <p class="vendor-tests">Tests Provided: ${product.testMeta.join(', ')}</p>
            <p class="vendor-price">₹${product.price}</p>
        </div>
        <form method="post" action="/cart/add">
            <input type="hidden" name="id" value="${product.variants[0].id}">
            <button type="submit" class="add-to-cart-btn">Add to Cart</button>
        </form>
        `;
        vendorsContainer.appendChild(vendorCard);
    });
  }

});
</script>


{% schema %}
{
  "name": "All Test Vendors",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Available Labs"
    }
  ],
  "presets": [
    {
      "name": "Default",
      "category": "Tests",
      "settings": {
        "heading": "Available Labs"
      }
    }
  ]
}
{% endschema %}
