<style>
.vendors-container {
  display: flex;
  flex-direction: column;
  gap: 20px;
  margin-top: 30px;
}

.vendor-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 15px;
  border: 1px solid #ddd;
  border-radius: 10px;
  background: #fff;
}

.vendor-image {
  width: 80px;
  height: 80px;
  object-fit: cover;
  border-radius: 10px;
  margin-right: 20px;
}

.product-vendor {
    margin: 0;
}

.vendor-info {
  flex: 1;
}

.vendor-title {
  font-size: 18px;
  font-weight: bold;
  margin: 8px 0;
}

.vendor-tests {
  font-size: 14px;
  color: #555;
  margin-bottom: 8px;
}

.vendor-price {
  font-size: 16px;
  font-weight: bold;
  color: #0d3c74;
}

.add-to-cart-btn {
  background: #0d3c74;
  color: white;
  padding: 10px 15px;
  border-radius: 8px;
  text-decoration: none;
  font-weight: bold;
}
</style>

<section>
  <h2>{{ section.settings.heading }}</h2>
  <div id="vendorsContainer" class="vendors-container"></div>
</section>

<script>
function getSelectedTestsFromURL() {
  const urlParams = new URLSearchParams(window.location.search);
  const tests = urlParams.get('tests');
  return tests ? tests.split(',') : [];
}

document.addEventListener("DOMContentLoaded", function() {
  const selectedTests = getSelectedTestsFromURL();

  const allProducts = [
    {% for product in collections.all.products %}
    {
      title: "{{ product.title | escape }}",
      handle: "{{ product.handle | escape }}",
      vendor: "{{ product.vendor | escape }}",
      variantId: " {{ product.selected_or_first_available_variant.id }}",
      productUrl: " {{ product.url }}",
      price: "{{ product.price | escape }}",
      compare_at_price: "{{ product.compare_at_price | escape }}",
      image: "{{ product.featured_image | img_url: 'medium' | escape }}",
      testMeta: {{ product.metafields.custom.test | default: '[]' }}
    }{% unless forloop.last %},{% endunless %}
    {% endfor %}
  ];

  const vendorsContainer = document.getElementById("vendorsContainer");

const normalize = str => str.toLowerCase().replace(/\s+/g, '-');

const matchingVendors = allProducts.filter(product => 
  Array.isArray(product.testMeta) &&
  selectedTests.some(test =>
    product.testMeta.some(metaTest => normalize(metaTest).includes(test.toLowerCase()) || test.toLowerCase().includes(normalize(metaTest)))
  )
);



console.log('97', matchingVendors)


  if (matchingVendors.length === 0) {
    vendorsContainer.innerHTML = "<p>No vendors found for selected tests.</p>";
    } else {
    matchingVendors.forEach(product => {
    const templateId = '{{  template.id }}'; // Replace or generate dynamically if needed
    const sectionId = `template--${templateId}__featured_collection${product.productId}`;

    const vendorCard = document.createElement("div");
    vendorCard.className = "vendor-card";

    vendorCard.innerHTML = `
        <a href="${product.productUrl.trim()}" class="vendor-link">
            <img src="${product.image}" alt="${product.title}" class="vendor-image">
            <div class="vendor-info">
                <h3 class="product-vendor">${product.vendor || 'Unknown Vendor'}</h3>
                <h6 class="vendor-title">${product.title}</h6>
                <p class="vendor-tests">Tests Provided: ${product.testMeta.join(', ')}</p>
                <p class="vendor-price">₹${product.price}</p>
            </div>
        </a>

        <form method="post"
              action="/cart/add"
              id="quick-add-${sectionId}"
              accept-charset="UTF-8"
              class="form"
              enctype="multipart/form-data"
              novalidate="novalidate"
              data-type="add-to-cart-form">

            <input type="hidden" name="form_type" value="product">
            <input type="hidden" name="utf8" value="✓">
            <input type="hidden" name="id" value="${product.variantId}" class="product-variant-id">
            <input type="hidden" name="product-id" value="${product.productId}">
            <input type="hidden" name="section-id" value="${sectionId}">

            <button id="quick-add-${sectionId}-submit"
                    type="submit"
                    name="add"
                    class="quick-add__submit button button--full-width"
                    aria-haspopup="dialog"
                    aria-labelledby="quick-add-${sectionId}-submit title-${sectionId}"
                    aria-live="polite"
                    data-sold-out-message="true">

                <span>Add to Cart</span>

                <span class="sold-out-message hidden">Sold out</span>

                <link href="//curebaylabtests.com/cdn/shop/t/12/assets/component-loading-spinner.css?v=116724955567955766481757222971" rel="stylesheet" type="text/css" media="all">

                <div class="loading__spinner hidden">
                    <svg aria-hidden="true" focusable="false" class="spinner" viewBox="0 0 66 66" xmlns="http://www.w3.org/2000/svg">
                        <circle class="path" fill="none" stroke-width="6" cx="33" cy="33" r="30"></circle>
                    </svg>
                </div>
            </button>
        </form>
    `;

    vendorsContainer.appendChild(vendorCard);
});

  }

});
</script>


{% schema %}
{
  "name": "All Test Vendors",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Available Labs"
    }
  ],
  "presets": [
    {
      "name": "Default",
      "category": "Tests",
      "settings": {
        "heading": "Available Labs"
      }
    }
  ]
}
{% endschema %}
