<style>
.vendors-container {
  display: flex;
  flex-direction: column;
  gap: 20px;
  margin-top: 30px;
}

.vendor-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 15px;
  border: 1px solid #ddd;
  border-radius: 10px;
  background: #fff;
}

.vendor-link {
  display: flex;
  text-decoration: none;
}

.vendor-image {
  width: 80px;
  height: 80px;
  object-fit: cover;
  border-radius: 10px;
  margin-right: 20px;
}

.product-vendor {
    margin: 0;
}

.vendor-info {
  flex: 1;
}

.vendor-title {
  font-size: 18px;
  font-weight: bold;
  margin: 8px 0;
}

.vendor-tests {
  font-size: 14px;
  color: #555;
  margin-bottom: 8px;
}

.vendor-price {
  font-size: 16px;
  font-weight: bold;
  color: #0d3c74;
}

.add-to-cart-btn {
      display: inline-flex;
    justify-content: center;
    align-items: center;
    border: var(--buttons-border-width) solid rgba(var(--color-button), var(--buttons-border-opacity));
    padding: 1.2rem 2rem;
    cursor: pointer;
    font: inherit;
    text-decoration: none;
    color: rgb(var(--color-button-text));
    background-color: rgba(var(--color-button), var(--alpha-button-background));
    transition: all .3s ease;
    -webkit-appearance: none;
    appearance: none;
}
</style>

<section>
  <h2>{{ section.settings.heading }}</h2>
  <div id="vendorsContainer" class="vendors-container"></div>
</section>

<script>
function getSelectedTestsFromURL() {
  const urlParams = new URLSearchParams(window.location.search);
  const tests = urlParams.get('tests');
  return tests ? tests.split(',') : [];
}

document.addEventListener("DOMContentLoaded", function() {
  const selectedTests = getSelectedTestsFromURL();

  const allProducts = [
    {% for product in collections.all.products %}
    {
      title: "{{ product.title | escape }}",
      handle: "{{ product.handle | escape }}",
      vendor: "{{ product.vendor | escape }}",
      variantId: " {{ product.selected_or_first_available_variant.id }}",
      productUrl: " {{ product.url }}",
      price: "{{ product.price | escape }}",
      compare_at_price: "{{ product.compare_at_price | escape }}",
      image: "{{ product.featured_image | img_url: 'medium' | escape }}",
      testMeta: {{ product.metafields.custom.test | default: '[]' }}
    }{% unless forloop.last %},{% endunless %}
    {% endfor %}
  ];

  const vendorsContainer = document.getElementById("vendorsContainer");

const normalize = str => str.toLowerCase().replace(/\s+/g, '-');

const matchingVendors = allProducts.filter(product => 
  Array.isArray(product.testMeta) &&
  selectedTests.some(test => {
    const testWords = test.toLowerCase().split(/[\s-]+/); // Split test into words
    
    return product.testMeta.some(metaTest => {
      const metaWords = normalize(metaTest).split('-'); // Split metaTest into words
      
      return testWords.some(tWord => metaWords.includes(tWord));
    });
  })
);


  if (matchingVendors.length === 0) {
    vendorsContainer.innerHTML = "<p>No vendors found for selected tests.</p>";
    } else {
    matchingVendors.forEach(product => {
        const vendorCard = document.createElement("div");
        vendorCard.className = "vendor-card";

        vendorCard.innerHTML = `
            <a href='/products/${product.handle}' class="vendor-link">
                <img src="${product.image}" alt="${product.title}" class="vendor-image">
                <div class="vendor-info">
                    <h3 class="product-vendor">${product.vendor || 'Unknown Vendor'}</h3>
                    <h6 class="vendor-title">${product.title}</h6>
                    <p class="vendor-tests">Tests Provided: ${product.testMeta.join(', ')}</p>
                    <p class="vendor-price">₹${product.price / 100}</p>
                </div>
            </a>

            <button class="add-to-cart-btn" onclick="addToCart('${product.variantId.trim()}')">
                Add to Cart
            </button>
        `;

        vendorsContainer.appendChild(vendorCard);
    });


  }

});
</script>

<script>
  function addToCart(variantId) {
    variantIdd = Number(variantId)
    fetch('/cart/add.js', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
      body: JSON.stringify({ id: variantIdd, quantity: 1 })
    })
    .then(response => response.json())
    .then(data => {
      drawerUpateCustom();
    })
    .catch(error => {
      console.error('Add to cart failed:', error);
      alert('Failed to add product to cart.');
    });
  }

  window.drawerUpateCustom = () => {
  fetch(`${routes.cart_url}?section_id=cart-drawer`)
    .then(data => data.text())
    .then(result => {
      const html = new DOMParser().parseFromString(result, 'text/html');

      document.querySelector('cart-drawer').innerHTML = '';
      document.querySelector('cart-drawer').append(html.documentElement.querySelector('#CartDrawer'));
      document.querySelector('cart-drawer').classList.remove('is-empty');

      if (!document.querySelector('.header__icons .cart-count-bubble')) {
        document.querySelector('#cart-icon-bubble').innerHTML += `<div class="cart-count-bubble"><span aria-hidden="true">1</span><span class="visually-hidden">1 item</span></div>`;
      } else {
        let updatedQty = parseInt(document.querySelector('.header__icons .cart-count-bubble').innerText.split('')[0]) + 1;
        console.log('updatedQty', updatedQty);
        document.querySelector('.header__icons .cart-count-bubble').innerText = updatedQty;
      }

      document.querySelector('#cart-icon-bubble').click();
    })
    .catch(error => {
      console.error('Cart update failed:', error);
    });
};

</script>



{% schema %}
{
  "name": "All Test Vendors",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Available Labs"
    }
  ],
  "presets": [
    {
      "name": "Default",
      "category": "Tests",
      "settings": {
        "heading": "Available Labs"
      }
    }
  ]
}
{% endschema %}
