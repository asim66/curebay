{% assign serviceable_pincode = shop.metaobjects.serviceable_pincode["serviceable-pincode-dpr6mvxj"] %}

<div id="pincodePopup" class="pincode-popup">
  <div class="pincode-content">
    <button id="closePincodePopup" class="close-btn">✕</button>
    <h2>Enter Your Pincode to check if we serve your area</h2>
    
    <div class="pincode-input-wrapper">
      <input type="text" id="pincodeInput" placeholder="Enter Pincode" maxlength="6" pattern="\d*"/>
      <button id="checkPincodeBtn" class="arrow-btn">→</button>
    </div>
    
    <p id="pincodeMessage" class="pincode-message"></p>
  </div>
</div>

<style>
.pincode-popup {
    position: fixed;
    top: 0; left: 0;
    width: 100%; height: 100%;
    background: rgba(0,0,0,0.5);
    display: none;
    justify-content: center;
    align-items: center;
    z-index: 9999;
}
.pincode-popup.active {
    display: flex !important;
}

.pincode-content {
    background: #fff;
    padding: 30px 25px;
    border-radius: 12px;
    text-align: center;
    width: 350px;
    position: relative;
    box-shadow: 0 6px 20px rgba(0,0,0,0.15);
    font-family: sans-serif;
}

.pincode-content h2 {
    font-size: 22px;
    font-weight: bold;
    margin-bottom: 8px;
    color: #0a3d4d;
}

.pincode-input-wrapper {
    display: flex;
    border: 1px solid #ccc;
    border-radius: 8px;
    overflow: hidden;
}

.pincode-input-wrapper input {
    border: none;
    flex: 1;
    padding: 10px 12px;
    font-size: 14px;
    outline: none;
}

.arrow-btn {
    background: #007c89;
    color: #fff;
    border: none;
    padding: 0 16px;
    cursor: pointer;
    font-size: 18px;
    transition: background 0.3s;
}

.arrow-btn:hover {
    background: #005f66;
}

.pincode-message {
    margin-top: 12px;
    font-size: 14px;
    display: none;
    color: red;
}

.close-btn {
    position: absolute;
    top: 12px;
    right: 12px;
    background: none;
    border: none;
    font-size: 20px;
    cursor: pointer;
    color: #333;
}
</style>

<script>
document.addEventListener('DOMContentLoaded', function() {
  const popup = document.getElementById('pincodePopup');
  const inputField = document.getElementById('pincodeInput');
  const message = document.getElementById('pincodeMessage');
  const checkBtn = document.getElementById('checkPincodeBtn');
  const productButtons = document.querySelector('.product-form__buttons');
  const closeBtn = document.getElementById('closePincodePopup');

  const userPincode = sessionStorage.getItem('userPincode');
  const popupClosed = sessionStorage.getItem('pincodePopupClosed');
  const isPDP = window.location.pathname.includes('/products/');

  if (!userPincode) {
    popup.classList.add('active');

    if (isPDP) {
      closeBtn.style.display = 'none';  // Force mandatory pincode on PDP
    } else {
      closeBtn.style.display = 'block';
      closeBtn.addEventListener('click', function() {
        sessionStorage.setItem('pincodePopupClosed', 'true');
        popup.classList.remove('active');
      });

      if (popupClosed) popup.classList.remove('active');
    }
  } else {
    popup.classList.remove('active');
    checkAvailability(userPincode);
  }

  inputField.addEventListener('input', function () {
    this.value = this.value.replace(/\D/g, '').slice(0, 6);
  });

  checkBtn.addEventListener('click', function() {
    const input = inputField.value.trim();

    if (input.length === 6) {
      sessionStorage.setItem('userPincode', input);
      sessionStorage.removeItem('pincodePopupClosed');
      popup.classList.remove('active');
      checkAvailability(input);
    } else {
      message.innerText = 'Please enter a valid 6-digit pincode.';
      message.style.display = 'block';
    }
  });

  function checkAvailability(pincode) {
    const variantSelector = document.querySelector('variant-selects');
    const variantIdField = document.querySelector('[name="id"]');
    const isProductVariant = variantSelector !== null;

    if (isProductVariant) {
      variantSelector.addEventListener('change', validateVariants);
      validateVariants();

      function validateVariants() {
        const variantInputs = document.querySelectorAll('variant-selects input[type="radio"]');

        variantInputs.forEach(input => {
          const variantMetaField = input.getAttribute('data-pincode') || '[]';

          let allowedPincodes = [];
          try {
            allowedPincodes = JSON.parse(variantMetaField);
          } catch (e) {
            console.error('Invalid pincode metadata:', variantMetaField);
          }

          const numericPincode = Number(pincode);

          if (allowedPincodes.includes(numericPincode)) {
            input.nextElementSibling.style.display = '';  // Show variant option
             productButtons.style.display = '';
          } else {
            input.nextElementSibling.style.display = 'none';  // Hide variant option
             productButtons.style.display = 'none';
          }
        });

        const visibleVariants = Array.from(document.querySelectorAll('variant-selects input[type="radio"]'))
          .some(input => input.nextElementSibling.style.display !== 'none');

        if (visibleVariants) {
          removeUnavailableMessage();
        } else {
          showUnavailableMessage();
        }
      }

    } else {
      
      const productMetaField = document.querySelector('product-info .no-variant')?.getAttribute('data-pincode');
      
      let allowedPincodes = [];
      try {
        allowedPincodes = JSON.parse(productMetaField);
      } catch (e) {
        console.error('Invalid pincode metadata:', productMetaField);
      }

      console.log('181', allowedPincodes, pincode);

      const numericPincode = Number(pincode);

      if (allowedPincodes.includes(numericPincode)) {
        productButtons.style.display = '';
        removeUnavailableMessage();
      } else {
        productButtons.style.display = 'none';
        showUnavailableMessage();
      }
    }
  }

  function showUnavailableMessage() {
    if (!document.querySelector('.availability-message')) {
      const el = document.createElement('div');
      el.className = 'availability-message';
      el.style.color = 'red';
      el.style.marginTop = '15px';
      el.innerText = 'Sorry this Lab is not available in your Area';
      document.querySelector('.product-form').prepend(el);
    }
  }

  function removeUnavailableMessage() {
    const msgEl = document.querySelector('.availability-message');
    if (msgEl) msgEl.remove();
  }
});
</script>

